# EL-FAITH MICROFINANCE ENVIRONMENT CONFIGURATION
PORT=5000
NODE_ENV=development

# MySQL Database Connection (via XAMPP / MariaDB or MySQL)
DATABASE_URL="mysql://root:@localhost:3306/elfaith_microfinance"

# JWT Secret Keys
JWT_SECRET="your_jwt_secret_key"
JWT_EXPIRES_IN="12h"

# CORS Allowed Origins
CLIENT_ORIGIN="http://localhost:5173"

# Uploads Directory
UPLOAD_DIR="./uploads"

# Organization Info
COMPANY_NAME="EL-FAITH MICROFINANCE"
COMPANY_BRANCH="Wassa Powuako"
COMPANY_REGION="Western Region, Ghana"
COMPANY_PHONE="+233 24 000 0000"
COMPANY_EMAIL="info@elfaithmicrofinance.com"
COMPANY_CURRENCY="GHS"
COMPANY_CURRENCY_SYMBOL="GH₵"
